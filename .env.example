# Polymarket Trading Bot — Environment Template
# Copy to .env and fill in your values. Never commit .env to git.

# ========== Required ==========
PRIVATE_KEY=0x...
FUNDER=

# ========== API ==========
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
CLOB_API_HOST=https://clob.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
RELAYER_URL=
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASS_PHRASE=

# ========== Blockchain ==========
CHAIN_ID=137
SIGNATURE_TYPE=2
POLYGON_RPC=
GET_POSITION_URL=https://data-api.polymarket.com/v1/market-positions

# ========== Market ==========
ASSET=btc
MARKET_INTERVAL_SECONDS=300
MARKET_SLUG_PREFIX=btc-updown-5m
PAPER_TRADING=1

# ========== Strategy params (defaults also in src/config/params.py) ==========
ORDER_SIZE=30
BUY_LIMIT_PRICE=0.99
SELL_LIMIT_PRICE=0.01
FEE_RATE=0.072
INITIAL_USDC=1000
# Main strategy params — fill before running (also empty in src/config/params.py)
ROI_THRESHOLD_LOW=
ROI_THRESHOLD_MEDIUM=
ROI_THRESHOLD_HIGH=
MOMENTUM_TICK_USD=
MOMENTUM_1S_USD=
LEG2_DIFF_FACTOR=
LEG2_DIFF_FLOOR=
LEG2_DIFF_FLOOR_PAPER=
RISK_STOP_TIME=
SPLIT_AMOUNT_USDC=100

# ========== Chainlink Data Streams (optional) ==========
CHAINLINK_BTC_FEED_ID=
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=

# ========== Telegram (optional) ==========
TELEGRAM_BOT_TOKEN=
MONGO_URI=

# ========== Logging ==========
LOG_LEVEL=INFO
