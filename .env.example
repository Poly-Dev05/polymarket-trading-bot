# ============================================================
# Polymarket BTC 5-Min Trading Bot
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================


# ============================================================
# TRADING MODE
# ============================================================

# 1 = Paper trading
# 0 = Live trading
PAPER_TRADING=1

# Safety switch for live trading.
# Must be explicitly enabled before placing real orders.
LIVE_TRADING_ENABLED=0


# ============================================================
# WALLET / AUTHENTICATION
# ============================================================

PRIVATE_KEY=0x...
FUNDER=

# Polymarket signature configuration
SIGNATURE_TYPE=2


# ============================================================
# POLYMARKET API
# ============================================================

GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

CLOB_API_HOST=https://clob.polymarket.com

CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

RELAYER_URL=

# Builder API — only required if using Builder Program functionality
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASS_PHRASE=


# ============================================================
# BLOCKCHAIN
# ============================================================

CHAIN_ID=137

POLYGON_RPC=

# Optional position API
GET_POSITION_URL=https://data-api.polymarket.com/v1/market-positions


# ============================================================
# MARKET
# ============================================================

ASSET=btc

MARKET_INTERVAL_SECONDS=300

MARKET_SLUG_PREFIX=btc-updown-5m


# ============================================================
# ORDER EXECUTION
# ============================================================

# Default order size in USDC
ORDER_SIZE=30

# Maximum amount allowed in a single order
MAX_ORDER_SIZE_USDC=50

# Maximum total exposure across open positions
MAX_POSITION_USDC=150

# Maximum number of simultaneous positions
MAX_OPEN_POSITIONS=3

# Maximum acceptable slippage
MAX_SLIPPAGE=0.02

# Cancel an unfilled order after this many seconds
ORDER_TIMEOUT_SECONDS=3

# Delay between order attempts
ORDER_COOLDOWN_SECONDS=1

# Number of retry attempts for failed API requests
ORDER_RETRY_COUNT=2


# ============================================================
# MARKET TIMING
# ============================================================

# Stop opening new positions this many seconds before market expiry
MARKET_END_BUFFER_SECONDS=10

# Minimum remaining market time required to enter
MIN_ENTRY_TIME_SECONDS=30

# Maximum age of market data before considering it stale
MAX_DATA_AGE_MS=1000


# ============================================================
# STRATEGY
# ============================================================

ROI_THRESHOLD_LOW=
ROI_THRESHOLD_MEDIUM=
ROI_THRESHOLD_HIGH=

MOMENTUM_TICK_USD=
MOMENTUM_1S_USD=

LEG2_DIFF_FACTOR=
LEG2_DIFF_FLOOR=
LEG2_DIFF_FLOOR_PAPER=

RISK_STOP_TIME=

SPLIT_AMOUNT_USDC=100


# ============================================================
# RISK MANAGEMENT
# ============================================================

# Maximum loss allowed per trade
MAX_LOSS_PER_TRADE_USDC=20

# Maximum daily loss
MAX_DAILY_LOSS_USDC=100

# Maximum consecutive losing trades
MAX_CONSECUTIVE_LOSSES=5

# Stop trading after reaching daily loss limit
DAILY_LOSS_STOP=1

# Stop trading if API / market data becomes unstable
DATA_STALE_STOP=1


# ============================================================
# PAPER TRADING
# ============================================================

# Starting virtual balance
PAPER_BALANCE_USDC=1000

# Simulated execution latency
PAPER_EXECUTION_DELAY_MS=50

# Simulated slippage
PAPER_SLIPPAGE=0.001


# ============================================================
# MARKET DATA
# ============================================================

# Binance BTC feed
BINANCE_SYMBOL=BTCUSDT

# Coinbase BTC feed
COINBASE_SYMBOL=BTC-USD

# Price update interval / processing window
PRICE_UPDATE_INTERVAL_MS=100


# ============================================================
# CHAINLINK DATA STREAMS
# ============================================================

# Optional — only required when using Chainlink Data Streams
CHAINLINK_BTC_FEED_ID=
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=


# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=

# Optional MongoDB storage
MONGO_URI=


# ============================================================
# WEBSOCKET
# ============================================================

# Reconnect automatically when WS connection drops
WS_AUTO_RECONNECT=1

# Initial reconnect delay
WS_RECONNECT_DELAY_MS=500

# Maximum reconnect delay
WS_MAX_RECONNECT_DELAY_MS=10000

# WebSocket heartbeat interval
WS_HEARTBEAT_SECONDS=20


# ============================================================
# API / NETWORK
# ============================================================

# HTTP request timeout
API_TIMEOUT_SECONDS=5

# Maximum API retry attempts
API_RETRY_COUNT=3

# Retry delay
API_RETRY_DELAY_MS=250


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO

# Enable detailed trading decisions
DEBUG_TRADING=0

# Enable raw market-data logging
DEBUG_MARKET_DATA=0

# Enable order request/response logging
DEBUG_ORDERS=0


# ============================================================
# DATABASE / STATE
# ============================================================

# Persist bot state between restarts
PERSIST_STATE=1

# Optional state file for local deployment
STATE_FILE=./data/bot_state.json
